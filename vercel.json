{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js",
      "headers": {
        "Access-Control-Allow-Origin": "https://www.scarfaura.com, https://scarfaura-frontend.vercel.app, http://localhost:5173",
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, PATCH, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization, Cookie, X-Requested-With, Accept",
        "Access-Control-Expose-Headers": "Set-Cookie",
        "Access-Control-Max-Age": "86400"
      }
    },
    {
      "src": "/api/auth/debug",
      "dest": "index.js",
      "headers": {
        "Access-Control-Allow-Origin": "https://www.scarfaura.com",
        "Access-Control-Allow-Credentials": "true"
      }
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}